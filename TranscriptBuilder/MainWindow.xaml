<Window x:Class="TranscriptBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Claude Code Transcript Builder" Height="600" Width="1040" MinHeight="420" MinWidth="620"
        Icon="Assets/app.ico" Loaded="Window_Loaded" Closing="Window_Closing">
    <!-- Every themed brush referenced below is defined at the Application level (App.ApplyTheme) so it
         can be swapped at runtime; don't add Window.Resources for them, since resource lookup checks the
         Window before the Application and a local copy would permanently shadow the theme swap. -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProjectPathText" Grid.Column="0" VerticalAlignment="Center"
                       Text="No project selected" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                       Margin="0,0,12,0"/>
            <Button x:Name="ThemeToggleButton" Grid.Column="1" Content="🌙 Dark Mode" Padding="10,4" Margin="0,0,8,0"
                    Click="ThemeToggleButton_Click" AutomationProperties.Name="Switch to dark mode"/>
            <Button x:Name="RevealTranscriptButton" Grid.Column="2" Content="Reveal in Explorer" Padding="10,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="RevealTranscriptButton_Click"
                    AutomationProperties.Name="Reveal AI_TRANSCRIPT.txt in File Explorer"/>
            <Button x:Name="SelectFolderButton" Grid.Column="3" Content="Select Project Folder…"
                    Padding="10,4" Click="SelectFolderButton_Click"/>
        </Grid>

        <!-- Live regions so screen readers announce status changes without moving focus. -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,4" Text="Select a project root directory to begin."
                   TextWrapping="Wrap" Foreground="{DynamicResource PrimaryStatusTextBrush}" AutomationProperties.LiveSetting="Polite"/>

        <TextBlock x:Name="NextEntryText" Grid.Row="2" Margin="0,0,0,8" Text="" FontStyle="Italic" Foreground="{DynamicResource SecondaryStatusTextBrush}"
                   AutomationProperties.LiveSetting="Polite"/>

        <!-- Session-metadata shortcuts. Each Log button writes an entry directly, independent of the
             compose box below; Insert Audit Prompt only edits the compose box, and Edit… only opens the
             prompt editor (see code-behind). -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,16,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ModelComboBox" Width="120" IsEditable="True" IsEnabled="False" Margin="0,0,6,0"
                              AutomationProperties.Name="Model name or alias">
                        <ComboBoxItem>opus</ComboBoxItem>
                        <ComboBoxItem>sonnet</ComboBoxItem>
                        <ComboBoxItem>haiku</ComboBoxItem>
                        <ComboBoxItem>opusplan</ComboBoxItem>
                        <ComboBoxItem>best</ComboBoxItem>
                        <ComboBoxItem>fable</ComboBoxItem>
                        <ComboBoxItem>default</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="LogModelButton" Content="Log" Padding="8,4" IsEnabled="False"
                            Click="LogModelButton_Click" AutomationProperties.Name="Log model"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource GroupBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="0,0,16,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Session:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SessionCommandComboBox" Width="130" IsEditable="False" IsEnabled="False"
                              SelectedIndex="0" Margin="0,0,6,0" AutomationProperties.Name="Session command">
                        <ComboBoxItem>/compact</ComboBoxItem>
                        <ComboBoxItem>/clear</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="LogSessionCommandButton" Content="Log" Padding="8,4" IsEnabled="False"
                            Click="LogSessionCommandButton_Click" AutomationProperties.Name="Log session command"/>
                </StackPanel>
            </Border>
            <Button x:Name="InsertAuditPromptButton" Content="Insert Audit Prompt" Padding="8,4" Margin="0,0,4,4" IsEnabled="False"
                    Click="InsertAuditPromptButton_Click"/>
            <Button x:Name="EditAuditPromptButton" Content="Edit…" Padding="8,4" Margin="0,0,16,4" IsEnabled="False"
                    Click="EditAuditPromptButton_Click" AutomationProperties.Name="Edit the saved audit prompt"/>
            <Button x:Name="LogClaudeMdUpdateButton" Content="Log CLAUDE.md Update" Padding="8,4" Margin="0,0,4,4" IsEnabled="False"
                    Click="LogClaudeMdUpdateButton_Click"/>
        </WrapPanel>

        <TextBox x:Name="ComposeBox" Grid.Row="4" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Padding="6" IsEnabled="False"
                 AutomationProperties.Name="Prompt compose box"
                 AutomationProperties.HelpText="Type or paste a prompt, then press Ctrl+Enter to log it"
                 PreviewKeyDown="ComposeBox_PreviewKeyDown" TextChanged="ComposeBox_TextChanged"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,4">
            <Button x:Name="LogButton" Content="Log Entry   (Ctrl+Enter)" Padding="12,6" IsEnabled="False"
                    Click="LogButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="FooterText" Grid.Row="6" Text="" TextWrapping="Wrap"
                   Foreground="{DynamicResource SuccessBrush}" AutomationProperties.LiveSetting="Assertive"/>
    </Grid>
</Window>
