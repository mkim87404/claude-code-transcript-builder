<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The public-facing product name: what the built .exe is named, and what Explorer/the taskbar
         show for it. Left independent of the project/namespace name (TranscriptBuilder), which stays
         as-is to avoid an unnecessary rename across every file. -->
    <AssemblyName>Claude Code Transcript Builder</AssemblyName>
    <Product>Claude Code Transcript Builder</Product>
    <AssemblyTitle>Claude Code Transcript Builder</AssemblyTitle>
    <!-- Kept in step with the GitHub release tag (vX.Y.Z), so the exe's file/product version matches it. -->
    <Version>1.0.0</Version>
    <!-- WPF's ThemeMode API (Fluent light/dark theming) is experimental as of .NET 10 — see NOTES.md
         for the trade-off analysis behind choosing it anyway over a hand-rolled ResourceDictionary. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TranscriptBuilder.Core\TranscriptBuilder.Core.csproj" />
  </ItemGroup>

</Project>
